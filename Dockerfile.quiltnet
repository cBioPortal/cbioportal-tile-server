FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# The retrieval worker is isolated from the pixel server because the text
# encoder and its CPU tensors are intentionally a large optional dependency.
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.5.1+cpu \
    "fastapi>=0.111.0" \
    "uvicorn[standard]>=0.30.0" \
    "boto3>=1.34.0" \
    "httpx>=0.27" \
    "numpy>=1.26" \
    "h5py>=3.11" \
    "Pillow>=10.0" \
    "open_clip_torch>=2.29.0" \
    "transformers>=4.40.0"

COPY app/ ./app/

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /bin/false appuser \
    && mkdir -p /cache/research-embeddings /cache/huggingface \
    && chown -R appuser:appuser /app /cache

USER appuser
EXPOSE 8080
CMD ["uvicorn", "app.embedding_service:app", "--host", "0.0.0.0", "--port", "8080"]
