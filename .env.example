# ── S3 / Dell ECS ────────────────────────────────────────────────────────────
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
WSI_ALLOWED_SOURCE_SCHEMES=s3
WSI_ALLOWED_SOURCE_PREFIXES=
WSI_ALLOWED_THUMBNAIL_PREFIXES=
WSI_AUTH_SECRET=replace-with-at-least-32-random-bytes
WSI_AUTH_AUDIENCE=cbioportal-wsi
WSI_AUTH_MAX_TTL=300

# ── CORS (add viewer and cBioPortal origins) ─────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://cbioportal.org,https://www.cbioportal.org

# ── Tuning (dev-friendly defaults) ──────────────────────────────────────────
MAX_OPEN_SLIDES=8           # small for local dev
REDIS_MAXMEMORY=256mb
REDIS_PASSWORD=replace-me
APP_MEMORY_LIMIT=4g
SERVER_PORT=8081
GUNICORN_TIMEOUT=180
CACHE_MISS_LOCK_TTL_SECONDS=120
CACHE_MISS_WAIT_TIMEOUT_SECONDS=60
THUMBNAIL_FETCH_CONCURRENCY=8
THUMBNAIL_S3_MAX_CONNECTIONS=32
THUMBNAIL_S3_CONNECT_TIMEOUT_SEC=1
THUMBNAIL_S3_READ_TIMEOUT_SEC=5
THUMBNAIL_S3_MAX_ATTEMPTS=2
# Optional stable JPEG used to establish the S3 connection during worker startup.
THUMBNAIL_PREWARM_URI=

# ── Optional Databricks dev namespace ───────────────────────────────────────
# The checked-in dev snapshot materializer uses the Databricks CLI `dev`
# profile and writes only these isolated tables.
# DATABRICKS_CONFIG_PROFILE=dev
# DATABRICKS_WAREHOUSE_ID=a52519fa662ce69d
# WSI_THUMBNAIL_REGISTRY_TABLE=cdsi_dev.wsi_test.slide_thumbnail_registry
# WSI_CANONICAL_ASSOCIATION_TABLE=cdsi_dev.wsi_test.canonical_slide_associations
# WSI_SUMMARY_TABLE=cdsi_dev.wsi_test.sample_wsi_summary
# THUMBNAIL_ARTIFACT_ROOT_URI=s3://mskmind-bkt/wsi-thumbnails-dev/masters
# THUMBNAIL_MANIFEST_URI=s3://mskmind-bkt/wsi-thumbnails-dev/manifest.json
