# ── S3 / Dell ECS ────────────────────────────────────────────────────────────
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
WSI_ALLOWED_SOURCE_SCHEMES=s3
WSI_ALLOWED_SOURCE_PREFIXES=
WSI_ALLOWED_THUMBNAIL_PREFIXES=
WSI_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Standard base64 of exactly 32 random bytes (openssl rand -base64 32); must
# match the key the study's sealed sources were produced with.
WSI_SOURCE_SEAL_KEY=replace-with-base64-of-32-random-bytes
WSI_AUTH_AUDIENCE=cbioportal-wsi
WSI_AUTH_MAX_TTL=300
WSI_RELEASE_ID=local-dev
IMAGE_GIT_SHA=development
WSI_SERVING_CONTRACT_VERSION=wsi-serving-v6

# ── CORS (add viewer and cBioPortal origins) ─────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://cbioportal.org,https://www.cbioportal.org

# ── Tuning (dev-friendly defaults) ──────────────────────────────────────────
MAX_OPEN_SLIDES=8           # small for local dev
REDIS_MAXMEMORY=256mb
REDIS_PASSWORD=replace-me
APP_MEMORY_LIMIT=4g
SERVER_PORT=8081
GUNICORN_TIMEOUT=180
CACHE_MISS_LOCK_TTL_SECONDS=120
CACHE_MISS_WAIT_TIMEOUT_SECONDS=60
THUMBNAIL_FETCH_CONCURRENCY=8
THUMBNAIL_S3_MAX_CONNECTIONS=32
THUMBNAIL_S3_CONNECT_TIMEOUT_SEC=1
THUMBNAIL_S3_READ_TIMEOUT_SEC=5
THUMBNAIL_S3_MAX_ATTEMPTS=2
# Optional stable JPEG used to establish the S3 connection during worker startup.
THUMBNAIL_PREWARM_URI=

# ── Optional WSI research assistant ─────────────────────────────────────────
# The key is read by the tile-server process only. Mount the file into the
# container (or use your deployment secret manager); do not send it to the UI.
WSI_AGENT_ENABLED=false
WSI_AGENT_PROVIDER=bedrock
BEDROCK_AGENT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_AWS_REGION=us-east-1
# BEDROCK_AWS_PROFILE=cbioportal-msk-666628074417
# BEDROCK_AWS_ENDPOINT_URL=https://bedrock-runtime.us-east-1.amazonaws.com
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
WSI_AGENT_TIMEOUT_SECONDS=60
WSI_AGENT_RATE_LIMIT_PER_MINUTE=10
WSI_RESEARCH_ENABLED=false
# WSI_RESEARCH_MANIFEST_URI=s3://mskmind-bkt/wsi-research/trial-v1/manifest.json
WSI_RESEARCH_RATE_LIMIT_PER_MINUTE=30
# Set true only for a local stack using the synthetic local-development user.
ANNOTATION_LOCAL_DEVELOPMENT=false
# Optional QuiltNet worker. Start it with `docker compose --profile research up`.
# Leave empty to use the explicitly labeled published-label fallback.
# WSI_RESEARCH_EMBEDDING_URL=http://quiltnet-search:8080
WSI_RESEARCH_EMBEDDING_TIMEOUT_SECONDS=60
WSI_RESEARCH_STATIC_FALLBACK=true
# QUILTNET_MODEL_NAME=hf-hub:wisdomik/QuiltNet-B-16-PMB

# ── Optional dev thumbnail namespace ────────────────────────────────────────
# THUMBNAIL_MANIFEST_URI=s3://mskmind-bkt/wsi-thumbnails-dev/manifest.json
