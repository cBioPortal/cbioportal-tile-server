<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="WSI tile loading benchmark" enabled="true"><stringProp name="TestPlan.comments">90% tiles, 5% metadata, 5% thumbnails.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments">
      <elementProp name="BASE_URL" elementType="Argument"><stringProp name="Argument.value">${__P(BASE_URL,http://localhost:8080)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="STUDY_ID" elementType="Argument"><stringProp name="Argument.value">${__P(STUDY_ID,coad_msk_2025)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="SLIDE_IDS" elementType="Argument"><stringProp name="Argument.value">${__P(SLIDE_IDS,2908638)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="BEARER_TOKEN" elementType="Argument"><stringProp name="Argument.value">${__P(BEARER_TOKEN,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="MAX_ZOOM" elementType="Argument"><stringProp name="Argument.value">${__P(MAX_ZOOM,9)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="TILE_GRID" elementType="Argument"><stringProp name="Argument.value">${__P(TILE_GRID,8)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
    </collectionProp></elementProp><stringProp name="TestPlan.user_define_classpath"></stringProp></TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Measured workload" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController"><boolProp name="LoopController.continue_forever">true</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(users,20)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp_seconds,20)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration_seconds,60)}</stringProp></ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="WSI authorization" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="Authorization" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${BEARER_TOKEN}</stringProp></elementProp><elementProp name="Accept" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Tiles 90 percent" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><stringProp name="ThroughputController.maxThroughput">90</stringProp></ThroughputController>
        <hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Tile coordinates" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def r=new Random(20260721L+ctx.threadNum+prev.sampleCount);def ids=vars.get('SLIDE_IDS').split(',');vars.put('slide_id',ids[r.nextInt(ids.length)].trim());def o=r.nextInt(6);def z=Math.max(0,Integer.parseInt(vars.get('MAX_ZOOM'))-o);def g=Math.max(1,Integer.parseInt(vars.get('TILE_GRID'))&gt;&gt;o);vars.put('z',z.toString());vars.put('x',r.nextInt(g).toString());vars.put('y',r.nextInt(g).toString())</stringProp></JSR223PreProcessor><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="ZXY tile" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/tiles/${slide_id}/zxy/${z}/${x}/${y}?studyId=${STUDY_ID}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/></hashTree>
        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Metadata 5 percent" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><stringProp name="ThroughputController.maxThroughput">5</stringProp></ThroughputController>
        <hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Select slide" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def ids=vars.get('SLIDE_IDS').split(',');vars.put('slide_id',ids[(ctx.threadNum+prev.sampleCount)%ids.length].trim())</stringProp></JSR223PreProcessor><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Metadata" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/tiles/${slide_id}/metadata?studyId=${STUDY_ID}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/></hashTree>
        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Thumbnail 5 percent" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><stringProp name="ThroughputController.maxThroughput">5</stringProp></ThroughputController>
        <hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Select slide" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def ids=vars.get('SLIDE_IDS').split(',');vars.put('slide_id',ids[(ctx.threadNum+prev.sampleCount)%ids.length].trim())</stringProp></JSR223PreProcessor><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Thumbnail" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/tiles/${slide_id}/thumbnail?width=256&amp;height=256&amp;studyId=${STUDY_ID}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/></hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
