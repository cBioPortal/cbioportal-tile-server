<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="WSI tile loading benchmark" enabled="true"><stringProp name="TestPlan.comments">95% tiles, 5% thumbnails for one slide, named by its resource row (STUDY_ID, KEY, ENC). Pass the portal session cookie as COOKIE (for example SESSION=...) when going through the ingress.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments">
      <elementProp name="BASE_URL" elementType="Argument"><stringProp name="Argument.value">${__P(BASE_URL,http://localhost:8080)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="STUDY_ID" elementType="Argument"><stringProp name="Argument.value">${__P(STUDY_ID,msk_spectrum_tme_2022)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="KEY" elementType="Argument"><stringProp name="Argument.value">${__P(KEY,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="ENC" elementType="Argument"><stringProp name="Argument.value">${__P(ENC,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="COOKIE" elementType="Argument"><stringProp name="Argument.value">${__P(COOKIE,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="MAX_ZOOM" elementType="Argument"><stringProp name="Argument.value">${__P(MAX_ZOOM,9)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
      <elementProp name="TILE_GRID" elementType="Argument"><stringProp name="Argument.value">${__P(TILE_GRID,8)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
    </collectionProp></elementProp><stringProp name="TestPlan.user_define_classpath"></stringProp></TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Measured workload" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController"><boolProp name="LoopController.continue_forever">true</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(users,20)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp_seconds,20)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration_seconds,60)}</stringProp></ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Portal session cookie" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="Cookie" elementType="Header"><stringProp name="Header.name">Cookie</stringProp><stringProp name="Header.value">${COOKIE}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Tiles 95 percent" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><stringProp name="ThroughputController.maxThroughput">95</stringProp></ThroughputController>
        <hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Tile coordinates" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def r=new Random(20260721L+ctx.threadNum+prev.sampleCount);def o=r.nextInt(6);def z=Math.max(0,Integer.parseInt(vars.get('MAX_ZOOM'))-o);def g=Math.max(1,Integer.parseInt(vars.get('TILE_GRID'))&gt;&gt;o);vars.put('z',z.toString());vars.put('x',r.nextInt(g).toString());vars.put('y',r.nextInt(g).toString())</stringProp></JSR223PreProcessor><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="ZXY tile" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/tiles/zxy/${z}/${x}/${y}?studyId=${STUDY_ID}&amp;key=${KEY}&amp;enc=${ENC}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/></hashTree>
        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Thumbnail 5 percent" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><stringProp name="ThroughputController.maxThroughput">5</stringProp></ThroughputController>
        <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Thumbnail" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/thumbnails?studyId=${STUDY_ID}&amp;key=${KEY}&amp;enc=${ENC}&amp;width=256&amp;height=256</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/></hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
